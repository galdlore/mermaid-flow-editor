{
  "name": "mermaid-gui-markdown-editor",
  "version": "2.1.5",
  "private": true,
  "description": "Windows 11 GUI Markdown and Mermaid Editor",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run electron:dev\"",
    "electron:dev": "wait-on http://localhost:5173 && npm run compile:electron && node -e \"const env={...process.env,VITE_DEV_SERVER_URL:'http://localhost:5173'};delete env.ELECTRON_RUN_AS_NODE;require('child_process').spawn(require('electron'),['.'],{env,stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "compile:electron": "tsc -p tsconfig.electron.json",
    "compile:chrome": "tsc -p tsconfig.chrome.json",
    "build": "tsc --noEmit && npm run compile:electron && vite build",
    "build:extension": "tsc --noEmit && vite build && npm run compile:chrome && node dist-chrome/build-extension.js",
    "dist": "npm run build && electron-builder --publish never",
    "test:unit": "node --test \"src/utils/*.test.ts\"",
    "test:ui": "vitest run",
    "test": "npm run test:unit && npm run test:ui"
  },
  "dependencies": {
    "@milkdown/kit": "^7.23.0",
    "@xyflow/react": "^12.3.5",
    "lucide-react": "^0.460.0",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^31.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^5.1.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.example.mermaid-markdown-editor",
    "productName": "Mermaid Markdown Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "MermaidMarkdownEditor.md",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "MermaidMarkdownEditor.markdown",
        "description": "Markdown Document",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}